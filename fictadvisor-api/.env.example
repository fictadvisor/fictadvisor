SECRET=

PORT=

FRONT_BASE_URL=
BASE_URL=
STATIC_DIR=

TELEGRAM_BOT_API_URL=
TELEGRAM_BOT_TOKEN=

FICTADVISOR_DATABASE_URL=

# S3-compatible object storage (MinIO).
# S3_ENDPOINT   — internal endpoint the API uses for data ops (e.g. http://minio:9000).
# S3_PUBLIC_URL — browser-reachable base for public avatar links + presigned URLs
#                 (e.g. https://storage.ficeadvisor.com). Falls back to S3_ENDPOINT if unset.
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# Redis, used to persist the visitor/user metrics across API restarts and to
# hold the outgoing email queue.
# Optional: with REDIS_URL unset the counters stay in memory and reset on restart
# and emails are sent inline on the request, exactly as before. Prod and dev share
# one Redis, kept apart by the database index in the URL (and/or the prefixes).
REDIS_URL=
METRICS_REDIS_PREFIX=
METRICS_FLUSH_INTERVAL_MS=
EMAIL_QUEUE_PREFIX=

SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=

ADMISSION_EMAIL=

COMPLAINT_CHAT_ID=
